# User work: never committed (the bundled example lives in examples/).
# Anchored to the repository root so examples/**/review/ stays tracked.
/outputs/
/output/
/projects/
/review/

# Rebuild leftovers inside the bundled example (previous versions, draft sheets)
examples/**/_archive/
examples/**/review/draft/

